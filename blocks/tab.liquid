{% doc %}
  Tab block for Tabbed Carousel section.
  Renders the tab button and a panel of its nested category card blocks.
  The button is moved into the section header tabs row by tabbed-carousel.js.
{% enddoc %}

<div class="tabbed-carousel__tab-group" {{ block.shopify_attributes }}>
  <button
    ref="tabs[]"
    on:click="/switchTab"
    data-tab-id="{{ block.id }}"
    class="tabbed-carousel__tab"
    type="button"
    role="tab"
    aria-selected="false"
  >
    {{ block.settings.tab_label | escape }}
  </button>

  <div
    ref="panels[]"
    class="tabbed-carousel__panel"
    data-tab-id="{{ block.id }}"
    hidden
    role="tabpanel"
  >
    <div class="tabbed-carousel__slideshow-wrapper">
      <div class="tabbed-carousel__track">
        {% content_for 'blocks' %}

        {% if block.settings.view_all_text != blank %}
          <a href="{{ block.settings.view_all_url }}" class="tabbed-carousel__view-all">
            <div class="tabbed-carousel__view-all-media">
              {% if block.settings.view_all_image %}
                {{
                  block.settings.view_all_image
                  | image_url: width: block.settings.view_all_image.width
                  | image_tag:
                    loading: 'lazy',
                    class: 'tabbed-carousel__view-all-bg',
                    sizes: '(min-width: 750px) 208px, 163px',
                    widths: '163,208,326,416',
                    alt: block.settings.view_all_text
                }}
              {% endif %}
              <div class="tabbed-carousel__view-all-overlay"></div>
            </div>
            <div class="tabbed-carousel__view-all-content">
              <span class="tabbed-carousel__view-all-arrow">&#8250;</span>
              <span class="tabbed-carousel__view-all-text">{{ block.settings.view_all_text | escape }}</span>
            </div>
          </a>
        {% endif %}
      </div>
      <div class="tabbed-carousel__arrows" aria-hidden="true">
        <button
          class="tabbed-carousel__arrow-prev"
          on:click="/previous"
          type="button"
          aria-label="Previous"
        >
          <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </button>
        <button
          class="tabbed-carousel__arrow-next"
          on:click="/next"
          type="button"
          aria-label="Next"
        >
          <span class="svg-wrapper">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
        </button>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Tab",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "tab_label",
      "label": "Tab label",
      "default": "Category"
    },
    {
      "type": "header",
      "content": "View all card"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all link"
    },
    {
      "type": "image_picker",
      "id": "view_all_image",
      "label": "View all image"
    }
  ],
  "blocks": [
    {
      "type": "category-card"
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
