<div class="section-background color-{{ section.settings.color_scheme }}"></div>

<tabbed-carousel-component
  class="
    section
    section--page-width
    color-{{ section.settings.color_scheme }}
    tabbed-carousel
    spacing-style
  "
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="page-width tabbed-carousel__header">
    {% if section.settings.heading != blank %}
      <h2 class="tabbed-carousel__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% assign tab_count = 0 %}
    {% for block in section.blocks %}
      {% if block.type == 'tab' %}
        {% assign tab_count = tab_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if tab_count > 0 %}
      <div class="tabbed-carousel__tabs" role="tablist">
        {% assign tab_idx = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'tab' %}
            <button
              ref="tabs[]"
              on:click="/switchTab"
              data-tab-index="{{ tab_idx }}"
              class="tabbed-carousel__tab{% if tab_idx == 0 %} tabbed-carousel__tab--active{% endif %}"
              aria-selected="{% if tab_idx == 0 %}true{% else %}false{% endif %}"
              role="tab"
              type="button"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.tab_label | escape }}
            </button>
            {% assign tab_idx = tab_idx | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {% assign tab_blocks = section.blocks | where: 'type', 'tab' %}
  {% for tab in tab_blocks %}
    {% assign panel_idx = forloop.index0 %}
    <div
      ref="panels[]"
      class="tabbed-carousel__panel"
      data-tab-index="{{ panel_idx }}"
      {% unless forloop.first %}hidden{% endunless %}
      role="tabpanel"
    >
      {% capture slides %}
        {% assign slide_count_for_tab = 0 %}
        {% assign found_tab = false %}
        {% for block in section.blocks %}
          {% if block.type == 'tab' %}
            {% if block.id == tab.id %}
              {% assign found_tab = true %}
              {% continue %}
            {% elsif found_tab %}
              {% break %}
            {% endif %}
          {% endif %}
          {% if block.type == 'category-card' and found_tab %}
            {% assign slide_count_for_tab = slide_count_for_tab | plus: 1 %}
            <div class="tabbed-carousel__card" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="tabbed-carousel__card-link">
              {% endif %}
              <div class="tabbed-carousel__card-image-wrapper">
                {% if block.settings.image %}
                  {{
                    block.settings.image
                    | image_url: width: block.settings.image.width
                    | image_tag:
                      loading: 'lazy',
                      class: 'tabbed-carousel__card-img',
                      sizes: '(min-width: 750px) 208px, 163px',
                      widths: '163,208,326,416',
                      alt: block.settings.image.alt
                  }}
                {% else %}
                  {{ 'collection-1' | placeholder_svg_tag: 'tabbed-carousel__card-placeholder' }}
                {% endif %}
              </div>
              <div class="tabbed-carousel__card-info">
                <span class="tabbed-carousel__card-title">{{ block.settings.title | escape }}</span>
                {% if block.settings.badge_text != blank %}
                  <span class="tabbed-carousel__badge">
                    <span class="tabbed-carousel__badge-dot"></span>
                    {{ block.settings.badge_text | escape }}
                  </span>
                {% endif %}
              </div>
              {% if block.settings.link != blank %}
                </a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}

        {% if tab.settings.view_all_text != blank %}
          {% assign slide_count_for_tab = slide_count_for_tab | plus: 1 %}
          <a href="{{ tab.settings.view_all_url }}" class="tabbed-carousel__view-all">
            <div class="tabbed-carousel__view-all-media">
              {% if tab.settings.view_all_image %}
                {{
                  tab.settings.view_all_image
                  | image_url: width: tab.settings.view_all_image.width
                  | image_tag:
                    loading: 'lazy',
                    class: 'tabbed-carousel__view-all-bg',
                    sizes: '(min-width: 750px) 208px, 163px',
                    widths: '163,208,326,416',
                    alt: tab.settings.view_all_text
                }}
              {% endif %}
              <div class="tabbed-carousel__view-all-overlay"></div>
            </div>
            <div class="tabbed-carousel__view-all-content">
              <span class="tabbed-carousel__view-all-arrow">&#8250;</span>
              <span class="tabbed-carousel__view-all-text">{{ tab.settings.view_all_text | escape }}</span>
            </div>
          </a>
        {% endif %}
      {% endcapture %}

      <div
        class="tabbed-carousel__slideshow-wrapper"
        style="--gutter-slide-width: var(--util-page-margin-offset);"
      >
        {% render 'slideshow',
          slides: slides,
          show_arrows: true,
          icon_style: 'arrow',
          icon_shape: 'circle',
          auto_hide_controls: false,
          infinite: false,
          initial_slide: 0,
          slide_count: slide_count_for_tab,
          slide_position: 'top',
          slideshow_gutters: 'start end',
          class: 'tabbed-carousel__slideshow'
        %}
      </div>
    </div>
  {% endfor %}
</tabbed-carousel-component>

<script src="{{ 'tabbed-carousel.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  /* ==============================
   * Tabbed Carousel - Section
   * ============================== */

  tabbed-carousel-component {
    display: block;
    position: relative;
  }

  .tabbed-carousel__header {
    margin-block-end: 24px;
  }

  /* Heading */
  .tabbed-carousel__heading {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 24px;
    line-height: 28px;
    color: var(--color-foreground);
    margin: 0 0 16px;

    @media screen and (min-width: 750px) {
      font-size: 40px;
      line-height: 48px;
      margin-block-end: 24px;
    }
  }

  /* Tabs */
  .tabbed-carousel__tabs {
    display: flex;
    gap: 24px;
    align-items: center;

    @media screen and (min-width: 750px) {
      gap: 32px;
    }
  }

  .tabbed-carousel__tab {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 20px;
    background: none;
    border: none;
    color: #181918;
    cursor: pointer;
    padding: 8px 0;
    border-radius: 24px;
    transition: background-color 0.2s ease, color 0.2s ease;

    @media screen and (min-width: 750px) {
      font-size: 20px;
      line-height: 24px;
    }
  }

  .tabbed-carousel__tab--active {
    font-weight: 700;
    background-color: #181918;
    color: #fff;
    padding: 8px 20px;

    @media screen and (min-width: 750px) {
      padding: 12px 24px;
    }
  }

  /* Panel */
  .tabbed-carousel__panel {
    position: relative;
  }

  .tabbed-carousel__panel[hidden] {
    display: none;
  }

  /* Slideshow wrapper */
  .tabbed-carousel__slideshow-wrapper {
    position: relative;
  }

  /* Slideshow gap overrides */
  .tabbed-carousel__slideshow slideshow-slides {
    --slideshow-gap: 8px;

    @media screen and (min-width: 750px) {
      --slideshow-gap: 16px;
    }
  }

  /* Card */
  .tabbed-carousel__card {
    flex: 0 0 163px;
    scroll-snap-align: start;

    @media screen and (min-width: 750px) {
      flex: 0 0 208px;
    }
  }

  .tabbed-carousel__card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .tabbed-carousel__card-image-wrapper {
    aspect-ratio: 163 / 245;
    overflow: hidden;
    border-radius: 0;
    background-color: rgb(var(--color-background-rgb, 245, 245, 245));

    @media screen and (min-width: 750px) {
      aspect-ratio: 208 / 277;
    }
  }

  .tabbed-carousel__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tabbed-carousel__card-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tabbed-carousel__card-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-block-start: 12px;
  }

  .tabbed-carousel__card-title {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 16px;
    line-height: 20px;
    color: #181918;

    @media screen and (min-width: 750px) {
      font-size: 20px;
      line-height: 24px;
    }
  }

  /* Badge */
  .tabbed-carousel__badge {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: #27863A;
  }

  .tabbed-carousel__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #27863A;
    flex-shrink: 0;
  }

  /* View All card */
  .tabbed-carousel__view-all {
    flex: 0 0 163px;
    scroll-snap-align: start;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    aspect-ratio: 163 / 245;

    @media screen and (min-width: 750px) {
      flex: 0 0 208px;
      aspect-ratio: 208 / 277;
    }
  }

  .tabbed-carousel__view-all-media {
    position: absolute;
    inset: 0;
  }

  .tabbed-carousel__view-all-bg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tabbed-carousel__view-all-overlay {
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.9);

    @media screen and (min-width: 750px) {
      background: rgba(0, 0, 0, 0.1);
    }
  }

  .tabbed-carousel__view-all-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 16px;
  }

  .tabbed-carousel__view-all-text {
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 24px;
    line-height: 28px;
    text-align: center;
    text-decoration: underline;
    color: #181918;

    @media screen and (min-width: 750px) {
      color: #fff;
    }
  }

  .tabbed-carousel__view-all-arrow {
    font-size: 20px;
    opacity: 0.3;
    color: #27863A;

    @media screen and (min-width: 750px) {
      color: #fff;
    }
  }

  /* Arrow overrides */
  .tabbed-carousel__panel slideshow-arrows {
    align-items: flex-start;
    justify-content: flex-end;
    mix-blend-mode: normal;
  }

  .tabbed-carousel__panel .slideshow-control--previous {
    display: none;
  }

  .tabbed-carousel__panel .slideshow-control--next {
    pointer-events: auto;
    opacity: 1;
    position: relative;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    background-color: #fff;
    border: 2px solid #27863A;
    backdrop-filter: blur(10px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: #27863A;
    margin-block-start: calc(245px / 2 - 22px);
    margin-inline-end: 16px;

    @media screen and (min-width: 750px) {
      margin-block-start: calc(277px / 2 - 22px);
      margin-inline-end: 32px;
    }
  }

  .tabbed-carousel__panel .slideshow-control--next .svg-wrapper,
  .tabbed-carousel__panel .slideshow-control--next svg {
    color: #27863A;
  }

  .tabbed-carousel__panel .slideshow-control[disabled] {
    display: none;
  }
{% endstylesheet %}

