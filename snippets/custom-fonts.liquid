{% doc %}
  Custom Fonts

  Loads Europa font files via @font-face declarations and overrides
  --font-heading--family so all heading levels (h1–h6) use Europa.

  Must be rendered AFTER 'theme-styles-variables' so the :root override
  takes precedence in the cascade.

  @example {% render 'custom-fonts' %}
{% enddoc %}

{% # theme-check-disable RemoteAsset %}
<link
  rel="preload"
  as="font"
  href="{{ 'europa-bold.woff2' | asset_url }}"
  type="font/woff2"
  crossorigin
>
{% # theme-check-enable RemoteAsset %}

<style>
  @font-face {
    font-family: 'Europa';
    src: url({{ 'europa-regular.woff2' | asset_url }}) format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Europa';
    src: url({{ 'europa-bold.woff2' | asset_url }}) format('woff2');
    font-weight: 700;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --font-heading--family: 'Europa', sans-serif;
  }
</style>
